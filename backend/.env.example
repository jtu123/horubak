PORT=8080
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/horubak.sqlite
# Public HTTPS deployments must use NODE_ENV=production and COOKIE_SECURE=true.
COOKIE_SECURE=false
# Set only behind a trusted reverse proxy that replaces forwarded headers.
TRUST_PROXY=0
# Optional: serve the built React site from this same backend origin.
# FRONTEND_DIST=../frontend/dist

# Optional OAuth settings. Keep values on the backend.
# Redirect URI: <APP_ORIGIN>/api/auth/social/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Redirect URI: <APP_ORIGIN>/api/auth/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Return URL: <APP_ORIGIN>/api/auth/social/apple/callback
# Apple requires a registered HTTPS domain, COOKIE_SECURE=true, and a Services ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Sign in with Apple .p8 private key contents. A single line with \n escapes is also accepted.
APPLE_PRIVATE_KEY=
