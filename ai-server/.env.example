# Set these in the cloud provider's secret/environment dashboard.
# At least 32 random characters; use the same value in Cloudflare ANALYSIS_SERVICE_TOKEN.
ANALYSIS_SERVICE_TOKEN=
GEMINI_API_KEY=
# Required: copy an available model ID from your Google AI Studio project.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
# The analysis image bakes small. Rebuild the image to change this model.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=1
WHISPER_LANGUAGE=ko
WHISPER_LOCAL_FILES_ONLY=true
HF_HUB_OFFLINE=1
MAX_UPLOAD_BYTES=26214400
MAX_DURATION_SECONDS=3600
STT_TIMEOUT_SECONDS=600
FFMPEG_TIMEOUT_SECONDS=90
TRACKING_TIMEOUT_SECONDS=100
# Optional override; must contain the pinned NanoDet checkpoint. The image bakes it at /app/models/nanodet.onnx.
TRACKING_MODEL_PATH=
# Full-source tracking: private Google Cloud Storage and a Cloud Run Job.
# Keep disabled until the bucket, CORS, service account and Job are configured.
TRACKING_STORAGE_DRIVER=disabled
TRACKING_GCS_BUCKET=
TRACKING_JOB_RESOURCE=
TRACKING_SIGNER_SERVICE_ACCOUNT=
TRACKING_ALLOWED_ORIGINS=https://horubak.pages.dev
# Explicit LOCAL DEVELOPMENT ONLY; forbidden when running in Cloud Run.
# TRACKING_STORAGE_DRIVER=local
# TRACKING_LOCAL_DIRECTORY=./.cache/full-tracking-data
# TRACKING_LOCAL_PUBLIC_URL=http://127.0.0.1:8000
# TRACKING_ALLOWED_ORIGINS=http://127.0.0.1:5173
